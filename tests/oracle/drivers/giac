"""A deliberately wrong Giac for the trust-boundary tests (tests/oracle/Refusals.lean).

SymLean runs it as `giac` with the script on standard input, and reads its records on standard
error. Like Giac it echoes the session on standard output. By the request, its answers are wrong,
outside the checked language, in variables the request does not have, left unevaluated, not the
lists the task expects, or on the wrong stream; one family is right, so that the numbering of its
constants can be pinned.
"""

import sys

script = sys.stdin.read()
request = script.strip().splitlines()[-1].replace(" ", "")
# Giac echoes the session on standard output, where no record is read.
print("0>> " + script.strip().replace("\n", "\n1>> "))


def out(*records):
    for record in records:
        print("@@", record, file=sys.stderr)


if "string(integrate((v0*exp(v0)),v0))" in request:
    # The primitive of x * exp x is x * exp x - exp x; this is off by a sign.
    out("antiderivative v0*exp(v0)+exp(v0)")
elif "string(integrate(exp((-(v0^2))),v0))" in request:
    out("antiderivative sqrt(pi)/2*erf(v0)")
elif "string(integrate(exp((v0^v0)),v0))" in request:
    out("antiderivative integrate(exp(ln(v0)+exp(ln(v0)*v0))/v0,v0)")
elif "string(integrate(cos(v0),v0))" in request:
    # The right answer, on the wrong stream.
    print("@@ antiderivative sin(v0)")
elif "string(integrate(sin(v0),v0))" in request:
    sys.exit(127)
elif "string(integrate((v0^2),v0))" in request:
    out("antiderivative x^3/3")
elif "string(integrate((v0^3),v0))" in request:
    # More on standard error than SymLean keeps: the answer would be cut.
    sys.stderr.write("// Time 0\n" * 1800000)
    out("antiderivative v0^4/4")
elif "string(integrate((v0^4),v0))" in request:
    out("failed giac gave up")
elif "string(integrate(" in request:
    # No record: Giac's message for a command that stops, as Giac writes it on standard error.
    print("Error: Bad Argument Value", file=sys.stderr)
elif "string(sum((1/v0),v0,1,n0))" in request:
    out("closed_form Psi(n0+1)+euler_gamma")
elif "string(sum(sin((v0^2)),v0,1,n0))" in request:
    out("closed_form sum(sin(v0^2),v0,1,n0)")
elif "string(sum(" in request:
    # The sum of k on [1, n] is n (n + 1) / 2, not n ^ 2 / 2.
    out("closed_form n0^2/2")
elif "string(solve([((((v0^2)+1)-0))=0],[v0]))" in request:
    out("solutions []")
elif "string(solve([((v0-v1))=0],[v0,v1]))" in request:
    out("solutions list[[v1,v1]]")
elif "string(solve([(((((v0^5)-v0)-1)-0))=0],[v0]))" in request:
    out("solutions list[[1.16730397826]]")
elif "string(solve([((v0-1))=0],[v0]))" in request:
    out("solutions 1,2]")
elif "string(solve([((v0-2))=0],[v0]))" in request:
    out("solutions list[[2,3]]")
elif "string(solve([((v0-3))=0],[v0]))" in request:
    out("solutions list[" + ",".join(["[3]"] * 51) + "]")
elif "string(solve([((v0-4))=0],[v0]))" in request:
    out("solutions list[4]")
elif "string(solve(" in request:
    # (3, 1) solves neither x ^ 2 + y ^ 2 = 5 nor x * y = 2.
    out("solutions list[[3,1]]")
elif "string(desolve(subst((d1-(d0^2))," in request:
    out("families [v0+c_0,-v0+c_0]")
elif "string(desolve(subst((d2-d0)," in request:
    out("families []")
elif "string(desolve(subst((d1-(2*d0))," in request:
    out("families c_1*exp(2*v0)")
elif "string(desolve(subst((d1-(1/d0))," in request:
    # For y' = 1 / y: the zero function, which Lean's 1 / 0 = 0 would make a solution.
    out("families 0")
elif "string(desolve(subst(((d2+d0)-0)," in request:
    # Right, with the second of Giac's two constants only, in a list of one family.
    out("families [c_1*sin(v0)]")
elif "string(desolve(" in request:
    # y' = y is solved by c_0 exp x, not by c_0 exp (2 x).
    out("families c_0*exp(2*v0)")
else:
    out("unsupported no such task")
